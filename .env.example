# ==============================================================================
# CIVentral Web Admin & Civic Management Environment Template (.env.example)
# Copy this file to .env and configure the credentials for your environment.
# ==============================================================================

# Application Settings
APP_ENV=development
APP_DEBUG=true

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# For Localhost (XAMPP / WampServer):
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=citizen_verification
CERT_DB_NAME=civentral_certificates
DB_USER=root
DB_PASSWORD=

# For Dokploy Cloud / Docker Internal Mesh:
# DB_HOST=citizeninformationandengagement-citizenregistry-ffbtjn
# DB_PORT=3306
# DB_NAME=citizen_verification
# CERT_DB_NAME=civentral_certificates
# DB_USER=civentral_user
# DB_PASSWORD=Civentral2026!

# ------------------------------------------------------------------------------
# SMTP Mail Server (PHPMailer for OTP & Automated Citizen Alerts)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=your_smtp_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM_EMAIL=your_smtp_email@gmail.com
SMTP_FROM_NAME="Civentral"

# ------------------------------------------------------------------------------
# Google reCAPTCHA Configuration (v2 Checkbox or v3 Invisible)
# ------------------------------------------------------------------------------
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# ------------------------------------------------------------------------------
# Google AI Studio / Gemini API Key (Citizen Grievance AI Analysis)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# API Gateway Endpoints
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=https://civentral.tech/api/employee
API_BASE_URL_CITIZEN=https://civentral.tech/api/citizen
